@echo off
setlocal EnableExtensions DisableDelayedExpansion
set "MONEY_EMPIRE_ROOT=%~dp0.."
rem PowerShell executes a fixed command; no ExecutionPolicy or system setting changes.
rem SHA-256 from python.org's signed release bundle for Python 3.14.7 embed-amd64.
powershell.exe -NoProfile -Command ^
 "$ErrorActionPreference = 'Stop'; try { $arch = $env:PROCESSOR_ARCHITECTURE; if ($env:PROCESSOR_ARCHITEW6432) { $arch = $env:PROCESSOR_ARCHITEW6432 }; if ($arch -ne 'AMD64') { throw 'Este instalador suporta Windows x64 (Intel/AMD).' }; $root = [IO.Path]::GetFullPath($env:MONEY_EMPIRE_ROOT); $dir = Join-Path $root '.tools\python'; $exe = Join-Path $dir 'python.exe'; $marker = Join-Path $dir 'money-empire-version.txt'; if ((Test-Path -LiteralPath $exe) -and (Test-Path -LiteralPath $marker) -and ((Get-Content -LiteralPath $marker -Raw).Trim() -eq '3.14.7')) { Write-Host 'Python 3.14.7 ja preparado.'; exit 0 }; $zip = Join-Path $root '.tools\python-3.14.7.zip'; New-Item -ItemType Directory -Force -Path (Join-Path $root '.tools') | Out-Null; $expected = 'd297e5ff019966817ad8502465176139f2d3d840fa4ed84b13bed399a6ab1f15'; $cached = (Test-Path -LiteralPath $zip) -and ((Get-FileHash -LiteralPath $zip -Algorithm SHA256).Hash -eq $expected); if (-not $cached) { [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12; $ProgressPreference = 'SilentlyContinue'; Write-Host 'Baixando Python 3.14.7 de python.org...'; Invoke-WebRequest -UseBasicParsing -Uri 'https://www.python.org/ftp/python/3.14.7/python-3.14.7-embed-amd64.zip' -OutFile $zip -TimeoutSec 180 }; if ((Get-FileHash -LiteralPath $zip -Algorithm SHA256).Hash -ne $expected) { throw 'Integridade do Python invalida. O arquivo nao sera executado.' }; Expand-Archive -LiteralPath $zip -DestinationPath $dir -Force; if (-not (Test-Path -LiteralPath $exe)) { throw 'Python nao encontrado no pacote extraido.' }; Set-Content -LiteralPath $marker -Value '3.14.7' -Encoding ASCII; Write-Host ('Python portatil preparado em ' + $dir) } catch { Write-Host ('ERRO: ' + $_.Exception.Message); exit 1 }"
exit /b %errorlevel%
