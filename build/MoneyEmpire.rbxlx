      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">MarketModel</string>
          <string name="Source"><![CDATA[local Config = require(if script then script.Parent.MarketConfig else "./MarketConfig")
local Market = {}
-- UTC-derived simulation: every server sees identical quotes; hopping cannot reset prices.
function Market.eventAt(now)
    local cycle = math.floor(now / Config.EventSeconds)
    local offset = now % Config.EventSeconds
    if offset >= Config.EventDuration then
        return nil, (cycle + 1) * Config.EventSeconds
    end
    local index = (cycle * 17 + math.floor(cycle / 7)) % #Config.Events + 1
    return Config.Events[index], cycle * Config.EventSeconds + Config.EventDuration
end
function Market.priceAt(sector, now)
    local index = table.find(Config.SectorOrder, sector)
    if not index then return nil end
    local tick = math.floor(now / Config.QuoteSeconds)
    local wave = 1 + 0.12 * math.sin(tick * 0.071 + index * 2.1) + 0.06 * math.sin(tick * 0.023 + index)
    local event = Market.eventAt(tick * Config.QuoteSeconds)
    local boost = if event and (event.Sector == sector or event.Sector == "All") then event.Price else 1
    return math.floor(Config.Sectors[sector].BasePrice * wave * boost * 100 + 0.5) / 100
end
function Market.snapshot(now)
    local revision = math.floor(now / Config.QuoteSeconds)
    local event, endsAt = Market.eventAt(now)
    local result = { Revision = revision, EndsAt = endsAt, Name = if event then event.Name else "MERCADO ESTÁVEL",
        Description = if event then event.Description else "Próximo evento em breve", Prices = {}, History = {}, Multipliers = {} }
    for _, sector in ipairs(Config.SectorOrder) do
        result.Prices[sector] = Market.priceAt(sector, now)
        result.Multipliers[sector] = if event and (event.Sector == sector or event.Sector == "All") then event.Income else 1
        local points = {}
        for i = Config.ChartPoints - 1, 0, -1 do
            table.insert(points, Market.priceAt(sector, (revision - i) * Config.QuoteSeconds))
        end
        result.History[sector] = points
    end
    return result
end
return Market
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">NumberFormatter</string>
          <string name="Source"><![CDATA[local suffixes = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }
local Formatter = {}
function Formatter.compact(value)
    if type(value) ~= "number" or value ~= value or math.abs(value) == math.huge then return "0" end
    local sign = if value < 0 then "-" else ""
    local n, tier = math.abs(value), 1
    while n >= 1000 and tier < #suffixes do n /= 1000; tier += 1 end
    local decimals = if tier == 1 or n >= 100 then 0 elseif n >= 10 then 1 else 2
    local rounded = math.floor(n * 10 ^ decimals + 0.5) / 10 ^ decimals
    if rounded >= 1000 and tier < #suffixes then rounded /= 1000; tier += 1; decimals = 2 end
    local text = string.format("%." .. decimals .. "f", rounded)
    if string.find(text, ".", 1, true) then text = string.gsub(string.gsub(text, "0+$", ""), "%.$", "") end
    return sign .. text .. suffixes[tier]
end
function Formatter.money(value) return "$" .. Formatter.compact(value) end
function Formatter.preciseMoney(value)
    if type(value)~="number" or value~=value or math.abs(value)==math.huge then return "$0.00" end
    return (if value<0 then "-$" else "$")..string.format("%.2f",math.abs(value))
end
return Formatter
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">UILayout</string>
          <string name="Source"><![CDATA[-- Sizes are based on the ScreenGui safe area, not the physical display resolution.
local Layout = {}
function Layout.calculate(width, height)
    local margin = 8
    local hudWidth = math.min(384, math.max(0, width - 2 * margin))
    local panelWidth = math.min(360, math.max(0, width - 2 * margin))
    return {
        Margin = margin, HudWidth = hudWidth, HudHeight = 50,
        PanelX = margin, PanelY = 66, PanelWidth = panelWidth,
        PanelHeight = math.min(500, math.max(0, height - 74)),
        DockY = 94, NewsY = 64, FeedbackY = 140,
        StatTextSize = if width < 360 then 16 else 18,
    }
end
return Layout
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">UXModel</string>
          <string name="Source"><![CDATA[local Config = require(if script then script.Parent.GameConfig else "./GameConfig")
local Economy = require(if script then script.Parent.Economy else "./Economy")
local UX = {}
function UX.nextBusiness(profile)
    for _,id in ipairs(Config.BusinessOrder) do if not profile.Businesses[id] then return id end end
    return nil
end
function UX.guide(profile)
    local water = profile.Businesses.Water
    local id,kind,target,title,step
    if not water then
        id="Water"; kind="Buy"; target=Config.Businesses.Water.Price; title="Abra sua primeira barraca"; step=1
    elseif water.Level==1 then
        id="Water"; kind="Upgrade"; target=Economy.upgradeCost(id,water); title="Melhore sua renda automática"; step=2
    elseif not profile.Businesses.FoodCart then
        id="FoodCart"; kind="Buy"; target=Config.Businesses.FoodCart.Price; title="Expanda para o carrinho de comida"; step=3
    else return nil end
    return {Id=id,Kind=kind,Target=target,Title=title,Step=step,Ready=profile.Cash>=target,
        Progress=math.clamp(profile.Cash/target,0,1),Remaining=math.max(0,target-profile.Cash)}
end
function UX.visibleBusiness(profile,id,showAll)
    return showAll or profile.Businesses[id]~=nil or UX.nextBusiness(profile)==id
end
return UX
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="13">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="14">
      <Properties>
        <string name="Name">MoneyEmpire</string>
      </Properties>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">DataManager</string>
          <string name="Source"><![CDATA[local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local Modules = game:GetService("ReplicatedStorage"):WaitForChild("Modules")
local Config = require(Modules.GameConfig)
local Economy = require(Modules.Economy)
local Investments = require(Modules.InvestmentModel)
local Policy = require(script.Parent.SessionPolicy)
local temporary = RunService:IsStudio() and Config.StudioTemporaryData
local store = if temporary then nil else DataStoreService:GetDataStore(if RunService:IsStudio() then Config.StudioStoreName else Config.StoreName)
local Manager = { Sessions = {}, Temporary = temporary }
local function copy(value)
    if type(value) ~= "table" then return value end
    local result = {}
    for key, child in pairs(value) do result[key] = copy(child) end
    return result
end
local function retry(callback)
    local ok, result
    for attempt = 1, Config.SaveRetries do
        ok, result = pcall(callback)
        if ok then return true, result end
        warn("[MoneyEmpire] DataStore tentativa " .. attempt .. ": " .. tostring(result))
        if attempt < Config.SaveRetries then task.wait(attempt) end
    end
    return false, result
end
function Manager.load(player)
    local session = { Token = HttpService:GenerateGUID(false), Profile = nil, Saving = false, Closing = false, Healthy = true, Status = "Carregando", LastSave = 0 }
    if temporary then
        session.Profile = Economy.newProfile()
        session.Status = "TESTE LOCAL • dados temporários"
    else
        local ok, record = retry(function()
            return store:UpdateAsync("Player_" .. player.UserId, function(old)
                local now = os.time()
                if not Policy.canAcquire(old, session.Token, now) then return nil end
                local profile = if old then old.Data else Economy.newProfile()
                if not Economy.validate(profile) then return nil end
                if not Investments.prepare(profile) then return nil end
                return { Format = 1, Data = profile, Lock = { Token = session.Token, Expires = now + Config.SessionLeaseSeconds } }
            end)
        end)
        if not ok or not Policy.owns(record, session.Token, os.time()) then
            return nil, "Não foi possível carregar seus dados com segurança. Aguarde um pouco e entre novamente."
        end
        session.Profile = record.Data
        session.LeaseExpires = record.Lock.Expires
        session.Status = "Salvamento conectado"
    end
    Manager.Sessions[player] = session
    return session
end
function Manager.save(player, release)
    local session = Manager.Sessions[player]
    if not session then return false end
    if release then session.Closing = true end
    -- Serialize saves so an older snapshot cannot overwrite a newer one.
    while session.Saving do task.wait(0.05) end
    if Manager.Sessions[player] ~= session then return false end
    if temporary then
        if release then Manager.Sessions[player] = nil end
        return true
    end
    if not session.Healthy or not Economy.validate(session.Profile) then return false end
    session.Saving = true
    local snapshot = copy(session.Profile)
    snapshot.Revision += 1
    local ok, record = retry(function()
        return store:UpdateAsync("Player_" .. player.UserId, function(old)
            if not Policy.owns(old, session.Token, os.time()) then return nil end
            return { Format = 1, Data = snapshot, Lock = if release then nil else { Token = session.Token, Expires = os.time() + Config.SessionLeaseSeconds } }
        end)
    end)
    local saved = ok and type(record) == "table" and record.Data.Revision == snapshot.Revision
        and (if release then record.Lock == nil else Policy.owns(record, session.Token, os.time()))
    if saved then
        session.Profile.Revision = snapshot.Revision
        session.LastSave = os.time()
        session.LeaseExpires = if release then 0 else record.Lock.Expires
        session.Status = "Salvo às " .. os.date("!%H:%M:%S", session.LastSave) .. " UTC"
    elseif ok then
        session.Healthy = false
        session.Status = "Sessão expirada"
    else
        session.Status = "Falha ao salvar • nova tentativa automática"
    end
    session.Saving = false
    if release then Manager.Sessions[player] = nil end
    if not session.Healthy and player.Parent then player:Kick("Sua sessão de dados expirou. Entre novamente para proteger seu progresso.") end
    return saved
end
function Manager.usable(session)
    if session.Closing or not session.Healthy then return false end
    if not temporary and os.time() >= session.LeaseExpires then
        session.Healthy = false
        return false
    end
    return true
end
return Manager
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="16">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Config = require(ReplicatedStorage.Modules.GameConfig)
local Economy = require(ReplicatedStorage.Modules.Economy)
local MarketConfig = require(ReplicatedStorage.Modules.MarketConfig)
local MarketModel = require(ReplicatedStorage.Modules.MarketModel)
local Investments = require(ReplicatedStorage.Modules.InvestmentModel)
local market, sentMarket = nil, {}
local function currentMarket()
    if not market or market.Revision ~= math.floor(os.time() / MarketConfig.QuoteSeconds) then
        market = MarketModel.snapshot(os.time())
    end
    return market
end
local Data = require(script.Parent.DataManager)
local World = require(script.Parent.WorldManager)
local Limiter = require(script.Parent.RateLimiter)
local remotes = Instance.new("Folder"); remotes.Name = "Remotes"; remotes.Parent = ReplicatedStorage
local action = Instance.new("RemoteEvent"); action.Name = "EmpireAction"; action.Parent = remotes
local state = Instance.new("RemoteEvent"); state.Name = "EmpireState"; state.Parent = remotes
local feedback = Instance.new("RemoteEvent"); feedback.Name = "EmpireFeedback"; feedback.Parent = remotes
local limits, lastWork, lastHome = {}, {}, {}
local closing, loading = false, 0
World.init()
for _, name in ipairs({ "Purchase", "Cash", "LevelUp", "Event", "Rare", "Prestige", "Error", "Success" }) do
    local sound = Instance.new("Sound"); sound.Name = name; sound.Volume = 0.35
    sound.Parent = game:GetService("SoundService"):WaitForChild("MoneyEmpireSounds")
end
local function ranking()
    local prices = currentMarket().Prices
    local rows = {}
    for player, session in pairs(Data.Sessions) do
        if not session.Closing then
            table.insert(rows, { Name = player.DisplayName, UserId = player.UserId, NetWorth = Economy.netWorth(session.Profile, prices), Cash = session.Profile.Cash, Businesses = Economy.count(session.Profile) })
        end
    end
    table.sort(rows, function(a, b) return a.NetWorth > b.NetWorth end)
    while #rows > 10 do table.remove(rows) end
    return rows
end
local function send(player, ranks)
    local session = Data.Sessions[player]
    if not session or session.Closing then return end
    local p = session.Profile
    local quote = currentMarket()
    local marketUpdate = if sentMarket[player] ~= quote.Revision then quote else nil
    state:FireClient(player, { Cash = p.Cash, NetWorth = Economy.netWorth(p, quote.Prices), Income = Economy.income(p, quote.Multipliers), Businesses = p.Businesses, Collection = p.Collection, Settings = p.Settings, Title = Economy.title(p, quote.Prices), SaveStatus = session.Status, Temporary = Data.Temporary, Ranking = ranks or ranking(), Market = marketUpdate, ServerTime = os.time(), Investments = p.Investments or {}, Trades = p.Trades or {}, RealizedProfit = p.RealizedProfit or 0 })
    sentMarket[player] = quote.Revision
end
local function joined(player)
    if closing then player:Kick("Servidor encerrando. Entre novamente."); return end
    loading += 1
    local session, errorMessage = Data.load(player)
    loading -= 1
    if not session then if player.Parent then player:Kick(errorMessage) end; return end
    if closing or not player.Parent then Data.save(player, true); return end
    local plot = World.assign(player)
    if not plot then Data.save(player, true); player:Kick("Os 8 terrenos estão ocupados. Tente outro servidor."); return end
    local stats = Instance.new("Folder"); stats.Name = "leaderstats"; stats.Parent = player
    for _, name in ipairs({ "Net Worth", "Cash", "Businesses" }) do
        local value = Instance.new("NumberValue"); value.Name = name; value.Parent = stats
    end
    player.CharacterAdded:Connect(function(character)
        character:WaitForChild("HumanoidRootPart", 10)
        if player.Parent then World.teleport(player); World.updateTag(player, session.Profile) end
    end)
    if player.Character then World.teleport(player) end
    World.refresh(player, session.Profile)
    send(player)
end
Players.PlayerAdded:Connect(joined)
for _, player in ipairs(Players:GetPlayers()) do task.spawn(joined, player) end
Players.PlayerRemoving:Connect(function(player)
    sentMarket[player] = nil
    World.release(player); limits[player] = nil; lastWork[player] = nil; lastHome[player] = nil
    Data.save(player, true)
end)
local function performAction(player, kind, payload)
    limits[player] = limits[player] or {}
    local now = os.clock()
    if not Limiter.allow(limits[player], now, Config.RemoteBurst, Config.RemotePerSecond) then return end
    if type(kind) ~= "string" or #kind > 24 then return end
    local session = Data.Sessions[player]
    if not session or not Data.usable(session) then return end
    local p, ok, message = session.Profile, false, nil
    if kind == "Sync" then sentMarket[player] = nil; send(player); return
    elseif kind == "OpenBusinesses" then feedback:FireClient(player,true,"Gerencie seu império.","OpenBusinesses"); return
    elseif kind == "InvestBuy" or kind == "InvestSell" then
        ok, message = Investments.trade(p, if kind == "InvestBuy" then "Buy" else "Sell", payload, currentMarket(), os.time())
    elseif kind == "Work" then
        if now - (lastWork[player] or -math.huge) < Config.WorkCooldown then return end
        lastWork[player] = now; ok, message = Economy.work(p)
    elseif kind == "Buy" or kind == "Upgrade" then
        if type(payload) ~= "string" or #payload > 32 or not Config.Businesses[payload] then return end
        if kind == "Buy" then ok, message = Economy.buy(p, payload) else ok, message = Economy.upgrade(p, payload) end
    elseif kind == "Home" then
        if now - (lastHome[player] or -math.huge) < 3 then return end
        lastHome[player] = now; World.teleport(player); return
    elseif kind == "ReducedMotion" then
        if type(payload) ~= "boolean" then return end
        p.Settings.ReducedMotion = payload; ok = true; message = "Preferência atualizada."
    else return end
    if message then feedback:FireClient(player, ok, message, kind) end
    if ok then
        if kind == "Buy" or kind == "Upgrade" then World.refresh(player, p) end
        if kind == "Buy" and Config.Businesses[payload].Rarity == "Secret" then
            feedback:FireAllClients(true, player.DisplayName .. " inaugurou Órbita Espacial • SECRET!", "Secret")
        end
        send(player)
    end
end
action.OnServerEvent:Connect(performAction)
World.OnInteract=performAction
local elapsed, snapshotElapsed = 0, 0
RunService.Heartbeat:Connect(function(dt)
    if closing then return end
    elapsed += dt; snapshotElapsed += dt
    if elapsed < Config.TickSeconds then return end
    local step = math.min(elapsed, 10); elapsed = 0
    local quote = currentMarket()
    local shouldSend = snapshotElapsed >= Config.SnapshotSeconds
    if shouldSend then snapshotElapsed = 0 end
    for player, session in pairs(Data.Sessions) do
        if Data.usable(session) then
            Economy.tick(session.Profile, step, quote.Multipliers)
            local stats = player:FindFirstChild("leaderstats")
            if stats then
                stats["Net Worth"].Value = math.floor(Economy.netWorth(session.Profile, quote.Prices))
                stats.Cash.Value = math.floor(session.Profile.Cash)
                stats.Businesses.Value = Economy.count(session.Profile)
            end
            World.refresh(player, session.Profile, quote.Prices); World.updateTag(player, session.Profile, quote.Prices)
        elseif not session.Healthy and player.Parent then
            player:Kick("Conexão de salvamento expirada. Entre novamente para proteger seus dados.")
        end
    end
    if shouldSend then
        local ranks = ranking()
        for player in pairs(Data.Sessions) do send(player, ranks) end
    end
end)
task.spawn(function()
    while not closing do
        task.wait(Config.AutosaveSeconds)
        for player, session in pairs(Data.Sessions) do
            if not closing and not session.Closing and not session.Saving then task.spawn(Data.save, player, false) end
        end
    end
end)
game:BindToClose(function()
    closing = true
    local deadline = os.clock() + 25
    while loading > 0 and os.clock() < deadline do task.wait(0.1) end
    local pending = 0
    for player in pairs(Data.Sessions) do
        pending += 1
        task.spawn(function() Data.save(player, true); pending -= 1 end)
    end
    while pending > 0 and os.clock() < deadline do task.wait(0.1) end
end)
print("[MoneyEmpire] MVP iniciado. Dados temporários:", Data.Temporary)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">RateLimiter</string>
          <string name="Source"><![CDATA[local Limiter = {}
function Limiter.allow(state, now, capacity, refill)
    state.Tokens = math.min(capacity, (state.Tokens or capacity) + math.max(0, now - (state.Last or now)) * refill)
    state.Last = now
    if state.Tokens < 1 then return false end
    state.Tokens -= 1
    return true
end
return Limiter
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">SessionPolicy</string>
          <string name="Source"><![CDATA[-- Pure lease policy, shared by persistence and its tests.
local Policy = {}
function Policy.canAcquire(record, token, now)
    if record == nil then return true end
    if type(record) ~= "table" or record.Format ~= 1 or type(record.Data) ~= "table" then return false end
    local lock = record.Lock
    if lock == nil then return true end
    if type(lock) ~= "table" or type(lock.Token) ~= "string" or type(lock.Expires) ~= "number" or lock.Expires ~= lock.Expires then return false end
    return lock.Token == token or lock.Expires <= now
end
function Policy.owns(record, token, now)
    return type(record) == "table" and record.Format == 1 and type(record.Lock) == "table"
        and record.Lock.Token == token and type(record.Lock.Expires) == "number" and record.Lock.Expires > now
end
return Policy
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">WorldManager</string>
          <string name="Source"><![CDATA[local Lighting = game:GetService("Lighting")
local Modules = game:GetService("ReplicatedStorage"):WaitForChild("Modules")
local Config = require(Modules.GameConfig)
local Economy = require(Modules.Economy)
local Format = require(Modules.NumberFormatter)
local Visual = require(Modules.BusinessVisual)
local World = { Plots = {} }
local colors = { ground = Color3.fromRGB(37, 56, 64), road = Color3.fromRGB(28, 34, 45), mint = Color3.fromRGB(94, 240, 186), white = Color3.fromRGB(235, 241, 239) }
local function part(parent, name, size, position, color, material)
    local p = Instance.new("Part")
    p.Name = name; p.Size = size; p.CFrame = if typeof(position)=="CFrame" then position else CFrame.new(position); p.Color = color
    p.Anchored = true; p.CanTouch=false; p.Material = material or Enum.Material.SmoothPlastic
    p.TopSurface = Enum.SurfaceType.Smooth; p.BottomSurface = Enum.SurfaceType.Smooth
    p.Parent = parent
    return p
end
local function sign(parent, text, position, width)
    local anchor = part(parent, "Sign", Vector3.new(width or 28, 6, 0.5), position, colors.road)
    local gui = Instance.new("SurfaceGui"); gui.Face = Enum.NormalId.Front; gui.CanvasSize = Vector2.new(800, 160); gui.Parent = anchor
    local label = Instance.new("TextLabel"); label.Size = UDim2.fromScale(1, 1); label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamBold; label.TextColor3 = colors.white; label.TextScaled = true; label.Text = text; label.Parent = gui
    return label
end
function World.init()
    Lighting.ClockTime=16.4; Lighting.Brightness=2
    local atmosphere=Instance.new("Atmosphere"); atmosphere.Name="EmpireAtmosphere"; atmosphere.Density=0.22
    atmosphere.Color=Color3.fromRGB(210,226,238); atmosphere.Decay=Color3.fromRGB(119,141,166); atmosphere.Parent=Lighting
    local grade=Instance.new("ColorCorrectionEffect"); grade.Name="EmpireColor"; grade.Saturation=0.08; grade.Contrast=0.06; grade.Parent=Lighting
    local root = Instance.new("Folder"); root.Name = "MoneyEmpireWorld"; root.Parent = workspace
    World.Root = root
    part(root, "Ground", Vector3.new(740, 2, 430), Vector3.new(0, -2, 0), colors.ground, Enum.Material.Grass)
    part(root, "EmpireAvenue", Vector3.new(720, 0.3, 42), Vector3.new(0, -0.8, 0), colors.road)
    for x = -330, 330, 30 do part(root, "RoadMark", Vector3.new(12, 0.05, 0.7), Vector3.new(x, -0.6, 0), colors.white) end
    for _,z in ipairs({-30,30}) do
        part(root,"Sidewalk",Vector3.new(720,0.8,16),Vector3.new(0,-0.2,z),Color3.fromRGB(185,195,187),Enum.Material.Concrete)
        for x=-300,300,60 do
            part(root,"LampPost",Vector3.new(0.5,12,0.5),Vector3.new(x,6,z),colors.road,Enum.Material.Metal)
            part(root,"Lamp",Vector3.new(3,0.4,3),Vector3.new(x,12,z),Color3.fromRGB(255,220,150),Enum.Material.Neon)
            part(root,"TreeTrunk",Vector3.new(1,5,1),Vector3.new(x+16,2.5,z),Color3.fromRGB(126,94,68),Enum.Material.Wood)
            local crown=part(root,"TreeCrown",Vector3.new(7,7,7),Vector3.new(x+16,7,z),Color3.fromRGB(81,135,107))
            crown.Shape=Enum.PartType.Ball; crown.CanCollide=false
        end
    end
    local spawn = Instance.new("SpawnLocation"); spawn.Name = "Arrival"; spawn.Size = Vector3.new(10, 1, 10)
    spawn.Position = Vector3.new(0, 1, 0); spawn.Anchored = true; spawn.Neutral = true; spawn.Duration = 0; spawn.Transparency = 1; spawn.Parent = root
    sign(root, "MONEY EMPIRE\nFROM $1 TO BILLIONAIRE", Vector3.new(0, 22, 200), 80)
    for i = 1, Config.PlotCount do
        local side = if i <= 4 then -1 else 1
        local x = ((i - 1) % 4 - 1.5) * Config.PlotSpacing
        local origin = Vector3.new(x, 0, side * 100)
        local plotFrame=CFrame.new(origin)*CFrame.Angles(0,if side<0 then math.pi else 0,0)
        local model = Instance.new("Model"); model.Name = "Plot_" .. i; model.Parent = root
        part(model, "Foundation", Vector3.new(132, 1, 122), origin, Color3.fromRGB(62, 79, 89), Enum.Material.Concrete)
        part(model,"EntryGlow",Vector3.new(100,0.2,1),plotFrame*CFrame.new(0,0.7,-57),colors.mint,Enum.Material.Neon)
        part(model,"WelcomePlaza",Vector3.new(128,0.2,28),plotFrame*CFrame.new(0,0.7,-43),Color3.fromRGB(181,194,185),Enum.Material.Concrete)
        local label=sign(model,"TERRENO DISPONÍVEL",plotFrame*CFrame.new(-12,7,-58),50)
        for _,localX in ipairs({-36,-12,12,36}) do
            part(model,"PedestrianPath",Vector3.new(2,0.15,88),plotFrame*CFrame.new(localX,0.75,14),Color3.fromRGB(158,176,169),Enum.Material.Concrete)
        end
        local content = Instance.new("Folder"); content.Name = "Businesses"; content.Parent = model
        local vault=Instance.new("Folder"); vault.Name="Vault"; vault.Parent=model
        local terminal=part(model,"ManagementTerminal",Vector3.new(4,4,3),plotFrame*CFrame.new(-45,2.8,-43),colors.road,Enum.Material.Metal)
        part(model,"TerminalScreen",Vector3.new(3,2,0.2),plotFrame*CFrame.new(-45,3.4,-44.6),colors.mint,Enum.Material.Neon)
        local prompt=Instance.new("ProximityPrompt"); prompt.ActionText="Gerenciar negócios"; prompt.ObjectText="Seu império"
        prompt.KeyboardKeyCode=Enum.KeyCode.F; prompt.MaxActivationDistance=10; prompt.RequiresLineOfSight=false; prompt.Enabled=false; prompt.Parent=terminal
        local plot={Model=model,Content=content,Vault=vault,Origin=origin,Frame=plotFrame,Label=label,Owner=nil,Levels={},VaultTier=-1,Prompt=prompt}
        prompt.Triggered:Connect(function(player)
            local hrp=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            if plot.Owner==player and hrp and (hrp.Position-terminal.Position).Magnitude<=12 and World.OnInteract then World.OnInteract(player,"OpenBusinesses") end
        end)
        World.Plots[i]=plot
    end
    -- Low cost skyline: decorative anchored geometry, no free physics objects.
    for i = 1, 18 do
        local height = 18 + (i * 17) % 70
        part(root, "Skyline", Vector3.new(22, height, 18), Vector3.new(-350 + i * 37, height / 2, 190), Color3.fromRGB(48 + i % 3 * 8, 65, 87))
    end
end
function World.assign(player)
    for _, plot in ipairs(World.Plots) do
        if not plot.Owner then
            plot.Owner = player; plot.Model:SetAttribute("OwnerUserId", player.UserId)
            plot.Prompt.Enabled=true
            plot.Prompt.ObjectText=player.DisplayName.." • negócios"
            return plot
        end
    end
    return nil
end
function World.find(player)
    for _, plot in ipairs(World.Plots) do if plot.Owner == player then return plot end end
    return nil
end
function World.teleport(player)
    local plot = World.find(player)
    if plot and player.Character then player.Character:PivotTo(plot.Frame*CFrame.new(0,5,-44)*CFrame.Angles(0,math.pi,0)) end
end
function World.release(player)
    local plot = World.find(player)
    if plot then
        plot.Owner=nil; plot.Levels={}; plot.VaultTier=-1; plot.Content:ClearAllChildren(); plot.Vault:ClearAllChildren(); plot.Prompt.Enabled=false
        plot.Model:SetAttribute("OwnerUserId", nil); plot.Label.Text = "TERRENO DISPONÍVEL"
    end
end
function World.refresh(player, profile, prices)
    local plot = World.find(player)
    if not plot then return end
    plot.Label.Text = player.DisplayName .. "  •  " .. Economy.title(profile, prices) .. "\n" .. Format.money(Economy.netWorth(profile, prices))
    local vaultTier = math.clamp(math.floor(math.log10(math.max(1, profile.Cash))), 0, 12)
    for index, id in ipairs(Config.BusinessOrder) do
        local owned = profile.Businesses[id]
        if owned and plot.Levels[id]~=owned.Level then
            local previous=plot.Content:FindFirstChild(id); if previous then previous:Destroy() end
            local c = Config.Businesses[id]
            local model=Visual.build(plot.Content,id,owned.Level)
            local base=plot.Frame*CFrame.new(-48+((index-1)%5)*24,0.7,-18+math.floor((index-1)/5)*30)
            model:PivotTo(base)
            sign(model,c.Name.."\nNv. "..owned.Level,base*CFrame.new(0,3,-10.5),18)
            plot.Levels[id]=owned.Level
        elseif not owned and plot.Levels[id] then
            local previous=plot.Content:FindFirstChild(id); if previous then previous:Destroy() end
            plot.Levels[id]=nil
        end
    end
    if plot.VaultTier~=vaultTier then
        plot.VaultTier=vaultTier; plot.Vault:ClearAllChildren()
        local vault=plot.Frame*CFrame.new(46,2.5,-44)
        part(plot.Vault,"Safe",Vector3.new(14,4,9),vault,colors.road,Enum.Material.Metal)
        for i=1,vaultTier do
            part(plot.Vault,"Gold",Vector3.new(2.5,1,2),vault*CFrame.new(-4+((i-1)%4)*2.7,2.5+math.floor((i-1)/4),0),Color3.fromRGB(255,208,88),Enum.Material.Metal)
        end
    end
end
function World.updateTag(player, profile, prices)
    local head = player.Character and player.Character:FindFirstChild("Head")
    if not head then return end
    local gui = head:FindFirstChild("EmpireTag")
    if not gui then
        gui = Instance.new("BillboardGui"); gui.Name = "EmpireTag"; gui.Size = UDim2.fromOffset(230, 65)
        gui.StudsOffset = Vector3.new(0, 3, 0); gui.MaxDistance = 90; gui.Parent = head
        local label = Instance.new("TextLabel"); label.Name = "Label"; label.Size = UDim2.fromScale(1, 1)
        label.BackgroundTransparency = 1; label.TextColor3 = colors.white; label.TextStrokeTransparency = 0.4
        label.Font = Enum.Font.GothamBold; label.TextSize = 15; label.Parent = gui
    end
    gui.Label.Text = player.DisplayName .. "\n" .. Format.money(Economy.netWorth(profile, prices)) .. " • " .. Economy.title(profile, prices)
end
return World
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="20">
    <Properties>
      <string name="Name">SoundService</string>
    </Properties>
    <Item class="Folder" referent="21">
      <Properties>
        <string name="Name">MoneyEmpireSounds</string>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="22">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="23">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="24">
        <Properties>
          <string name="Name">MoneyEmpireClient</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Input = game:GetService("UserInputService")
local Modules = ReplicatedStorage:WaitForChild("Modules")
local Config = require(Modules.GameConfig)
local MarketConfig = require(Modules.MarketConfig)
local Economy = require(Modules.Economy)
local Format = require(Modules.NumberFormatter)
local UILayout = require(Modules.UILayout)
local UX = require(Modules.UXModel)
local Visual = require(Modules.BusinessVisual)
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local action = remotes:WaitForChild("EmpireAction")
local theme = { bg = Color3.fromRGB(14,23,34), panel = Color3.fromRGB(24,37,50), card = Color3.fromRGB(32,48,62),
    muted = Color3.fromRGB(152,174,189), white = Color3.fromRGB(238,245,248), mint = Color3.fromRGB(107,241,184),
    gold = Color3.fromRGB(255,211,123), error = Color3.fromRGB(255,140,144) }
local gui = Instance.new("ScreenGui"); gui.Name = "MoneyEmpireUI"; gui.ResetOnSpawn = false
gui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets; gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
local function frame(parent, size, position, color)
    local f = Instance.new("Frame"); f.Size = size; f.Position = position; f.BackgroundColor3 = color or theme.panel
    f.BorderSizePixel = 0; f.Parent = parent
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0,8); c.Parent = f; return f
end
local function label(parent, text, size, position, font, color)
    local l = Instance.new("TextLabel"); l.Size = size; l.Position = position; l.BackgroundTransparency = 1
    l.Text = text; l.TextColor3 = color or theme.white; l.Font = Enum.Font.GothamMedium; l.TextSize = font or 12
    l.TextXAlignment = Enum.TextXAlignment.Left; l.TextTruncate = Enum.TextTruncate.AtEnd; l.Parent = parent; return l
end
local function button(parent, text, size, position, callback, color)
    local b = Instance.new("TextButton"); b.Size = size; b.Position = position; b.BackgroundColor3 = color or theme.mint
    b.Text = text; b.TextSize = 12; b.Font = Enum.Font.GothamBold; b.TextColor3 = theme.bg; b.BorderSizePixel = 0; b.Parent = parent
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0,8); c.Parent = b
    b.Activated:Connect(callback); return b
end
local function enable(b, yes)
    b.Active = yes; b.AutoButtonColor = yes; b.BackgroundColor3 = if yes then theme.mint else theme.panel
    b.TextColor3 = if yes then theme.bg else theme.muted
end
local root = frame(gui, UDim2.fromScale(1,1), UDim2.new()); root.BackgroundTransparency = 1
local header = frame(root, UDim2.fromOffset(384,50), UDim2.fromOffset(8,8), theme.bg)
local stats = {}
for i, name in ipairs({"DINHEIRO", "PATRIMÔNIO", "RENDA / SEG"}) do
    local cell = frame(header, UDim2.new(1/3,-8,1,-8), UDim2.new((i-1)/3,4,0,4))
    label(cell,name,UDim2.new(1,-12,0,13),UDim2.fromOffset(6,3),9,theme.muted)
    stats[i] = label(cell,"—",UDim2.new(1,-12,0,23),UDim2.fromOffset(6,16),18,if i==3 then theme.mint else theme.white)
end
local news = button(root,"MARKET NEWS • conectando",UDim2.fromOffset(384,24),UDim2.fromOffset(8,64),function() end,theme.panel)
news.TextColor3 = theme.gold; news.TextSize = 11
local dock = frame(root,UDim2.fromOffset(384,40),UDim2.fromOffset(8,94),theme.bg)
local panel = frame(root,UDim2.fromOffset(360,460),UDim2.fromOffset(8,66),theme.bg)
panel.Name = "MenuDrawer"; panel.Visible = false; panel.ClipsDescendants = true; panel.Active = true
local title = label(panel,"Seu império",UDim2.new(1,-70,0,28),UDim2.fromOffset(12,8),17)
local hint = label(panel,"",UDim2.new(1,-24,0,20),UDim2.fromOffset(12,37),11,theme.muted)
local tabs = frame(panel,UDim2.new(1,-20,0,80),UDim2.fromOffset(10,62))
local scroll = Instance.new("ScrollingFrame"); scroll.Name = "Content"; scroll.BackgroundTransparency = 1; scroll.BorderSizePixel = 0
scroll.ScrollBarThickness = 4; scroll.ScrollBarImageColor3 = theme.mint; scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
scroll.CanvasSize = UDim2.new(); scroll.Parent = panel
local list = Instance.new("UIListLayout"); list.Padding = UDim.new(0,8); list.SortOrder = Enum.SortOrder.LayoutOrder; list.Parent = scroll
local save = label(panel,"Conectando…",UDim2.new(1,-24,0,26),UDim2.new(0,12,1,-30),10,theme.muted)
local feedback = label(root,"",UDim2.fromOffset(384,32),UDim2.fromOffset(8,140),12,theme.mint)
feedback.TextWrapped = true; feedback.TextTruncate = Enum.TextTruncate.None
local state, tab, signature, lot, history = nil, "Negócios", "", 1, false
local showAll,guideHidden=false,false
local cards, tabButtons, lotButtons = {}, {}, {}
local tabNames = {"Negócios","Mercado","Investir","Coleção","Ranking","Ajustes"}
local render, resize, openMenu, slide, updatePreviews, updateGuide
local guide=frame(root,UDim2.fromOffset(384,66),UDim2.fromOffset(8,144),theme.bg)
local guideTitle=label(guide,"Bem-vindo ao seu império",UDim2.new(1,-108,0,23),UDim2.fromOffset(10,6),12)
local guideDetail=label(guide,"Conectando…",UDim2.new(1,-108,0,20),UDim2.fromOffset(10,29),10,theme.muted)
local progressTrack=frame(guide,UDim2.new(1,-20,0,4),UDim2.new(0,10,1,-9),theme.panel)
local progressFill=frame(progressTrack,UDim2.fromScale(0,1),UDim2.new(),theme.mint)
local guideAction=button(guide,"Começar",UDim2.fromOffset(88,44),UDim2.new(1,-98,0,8),function()
    if not state then return end
    local step=UX.guide(state)
    if step then action:FireServer(if step.Ready then step.Kind else "Work",if step.Ready then step.Id else nil) end
end)
local messageUntil = 0
local pendingTrade
local confirmation=frame(panel,UDim2.new(1,-16,0,220),UDim2.fromOffset(8,62),theme.bg)
confirmation.Name="TradeConfirmation"; confirmation.ZIndex=20; confirmation.Visible=false; confirmation.Active=true
local confirmTitle=label(confirmation,"Conferir investimento",UDim2.new(1,-24,0,30),UDim2.fromOffset(12,10),16)
local confirmText=label(confirmation,"",UDim2.new(1,-24,0,120),UDim2.fromOffset(12,46),12,theme.muted)
confirmText.TextWrapped=true; confirmText.TextTruncate=Enum.TextTruncate.None
button(confirmation,"Cancelar",UDim2.new(0.5,-16,0,44),UDim2.new(0,12,1,-54),function() confirmation.Visible=false; pendingTrade=nil end,theme.muted)
local confirmButton=button(confirmation,"Confirmar",UDim2.new(0.5,-16,0,44),UDim2.new(0.5,4,1,-54),function()
    if not pendingTrade then return end
    local request=pendingTrade; pendingTrade=nil; confirmation.Visible=false
    action:FireServer(request.Kind,{Sector=request.Sector,Units=request.Units,Revision=request.Revision})
end)
local function confirmTrade(kind,sector)
    local price=state.Market.Prices[sector]
    local gross=price*lot
    local buying=kind=="InvestBuy"
    local total=if buying then math.ceil(gross*(1+MarketConfig.Fee)*100)/100 else math.floor(gross*(1-MarketConfig.Fee)*100)/100
    pendingTrade={Kind=kind,Sector=sector,Units=lot,Revision=state.Market.Revision}
    confirmTitle.Text=if buying then "Confirmar compra" else "Confirmar venda"
    confirmText.Text=MarketConfig.Sectors[sector].Name.." • "..lot.." cota(s)\nPreço por cota: "..Format.preciseMoney(price)
        .."\nTaxa de 2%: "..Format.preciseMoney(math.abs(total-gross)).."\nTotal "..(if buying then "a pagar: " else "a receber: ")..Format.preciseMoney(total).."\nSomente moeda virtual do jogo."
    enable(confirmButton,true); confirmation.Visible=true
end
openMenu = function(open, nextTab)
    confirmation.Visible=false; pendingTrade=nil
    if nextTab and nextTab ~= tab then tab = nextTab; signature = "" end
    if slide then slide:Cancel(); slide = nil end
    panel.Visible = open; dock.Visible = not open; news.Visible = not open; feedback.Visible = not open
    if updateGuide then updateGuide() end
    if updatePreviews and not open then updatePreviews() end
    if resize then resize() end
    if open and state and state.Market then
        render()
        if not state.Settings.ReducedMotion then
            local target = panel.Position; panel.Position = target - UDim2.fromOffset(8,0)
            slide = TweenService:Create(panel,TweenInfo.new(0.14),{Position=target}); slide:Play()
        end
    end
end
button(panel,"×",UDim2.fromOffset(44,44),UDim2.new(1,-50,0,4),function() openMenu(false) end,theme.gold)
button(dock,if Input.TouchEnabled then "Negócios" else "Menu [B]",UDim2.new(0.28,-4,1,-4),UDim2.fromOffset(2,2),function() openMenu(true) end,theme.gold)
local workButton=button(dock,"+$2  Trabalhar",UDim2.new(0.46,-4,1,-4),UDim2.new(0.28,2,0,2),function() action:FireServer("Work") end)
button(dock,"Terreno",UDim2.new(0.26,-4,1,-4),UDim2.new(0.74,2,0,2),function() action:FireServer("Home") end,theme.muted)
news.Activated:Connect(function() openMenu(true,"Mercado") end)
for _, name in ipairs(tabNames) do
    tabButtons[name] = button(tabs,name,UDim2.new(),UDim2.new(),function()
        confirmation.Visible=false; pendingTrade=nil
        if tab ~= name then tab = name; signature = "" end
        if state and state.Market then render() end
    end)
end
local function clear()
    cards = {}; lotButtons = {}; scroll.CanvasPosition = Vector2.zero
    for _, child in ipairs(scroll:GetChildren()) do if child:IsA("GuiObject") then child:Destroy() end end
end
local function card(height,order)
    local row = frame(scroll,UDim2.new(1,-7,0,height),UDim2.new(),theme.card); row.LayoutOrder = order or 0; return row
end
local function details(row)
    return {Row=row, Title=label(row,"",UDim2.new(1,-24,0,24),UDim2.fromOffset(12,6),14),
        Detail=label(row,"",UDim2.new(1,-24,0,22),UDim2.fromOffset(12,32),11,theme.muted)}
end
updateGuide=function()
    local step=state and UX.guide(state)
    guide.Visible=step~=nil and not guideHidden and not panel.Visible and root.AbsoluteSize.Y>=480
    if step then
        guideTitle.Text=step.Step.."/3 • "..step.Title
        guideDetail.Text=if step.Ready then "Tudo pronto. Dê o próximo passo!" else "Faltam "..Format.money(step.Remaining).." • renda e trabalho ajudam"
        guideAction.Text=if step.Ready then (if step.Kind=="Upgrade" then "Melhorar" else "Inaugurar") else "+$2 Trabalhar"
        progressFill.Size=UDim2.fromScale(step.Progress,1)
    end
    feedback.Position=UDim2.fromOffset(8,if guide.Visible then 216 else 144)
end
updatePreviews=function()
    -- Only visible cards allocate a model and a camera (at most four previews).
    local active=0
    for _,id in ipairs(Config.BusinessOrder) do
        local row=cards[id]
        if row and row.Preview then
            local y=row.Row.AbsolutePosition.Y
            local visible=panel.Visible and row.Row.Visible and y+row.Row.AbsoluteSize.Y>=scroll.AbsolutePosition.Y
                and y<=scroll.AbsolutePosition.Y+scroll.AbsoluteSize.Y and active<4
            local level=if state and state.Businesses[id] then state.Businesses[id].Level else 1
            if visible then active+=1 end
            if not visible or row.PreviewLevel~=level then
                row.Preview:ClearAllChildren(); row.PreviewLevel=nil
            end
            if visible and not row.PreviewLevel then
                local model,height=Visual.build(row.Preview,id,level)
                local camera=Instance.new("Camera"); camera.FieldOfView=35
                local distance=math.max(38,height*1.6)
                camera.CFrame=CFrame.lookAt(Vector3.new(distance*0.65,height*0.7,-distance),Vector3.new(0,height*0.36,0))
                camera.Parent=row.Preview; row.Preview.CurrentCamera=camera; row.PreviewLevel=level
            end
        end
    end
end
render = function()
    if not state or not state.Market or not panel.Visible then return end
    for name,b in pairs(tabButtons) do b.BackgroundColor3 = if name==tab then theme.mint else theme.card; b.TextColor3 = if name==tab then theme.bg else theme.white end
    title.Text = tab
    local count = 0; for _ in pairs(state.Collection) do count += 1 end
    hint.Text = if tab=="Coleção" then count.." / "..#Config.BusinessOrder.." descobertos"
        elseif tab=="Investir" then "Moeda fictícia • taxa de 2% por operação"
        elseif tab=="Mercado" then state.Market.Description
        elseif tab=="Ranking" then "Top 10 • inclui o valor atual da carteira"
        elseif tab=="Ajustes" then "MONEY EMPIRE • From $1 to Billionaire"
        elseif not state.Businesses.Water then "Trabalhe 5 vezes e compre Água gelada."
        else "Renda automática gratuita. Continue expandindo!"
    local key = tab..tostring(history)
    if signature ~= key then
        signature = key; clear()
        if tab=="Negócios" or tab=="Coleção" then
            if tab=="Negócios" then
                button(card(44,0),if showAll then "Mostrar meus negócios + próximo" else "Ver catálogo completo",UDim2.new(1,-8,1,-8),UDim2.fromOffset(4,4),function()
                    showAll=not showAll; signature=""; render()
                end,theme.gold)
            end
            for i,id in ipairs(Config.BusinessOrder) do
                local row = card(if tab=="Negócios" then 130 else 64,i+1); local c = details(row)
                if tab=="Negócios" then
                    c.Preview=Instance.new("ViewportFrame"); c.Preview.Size=UDim2.fromOffset(66,66); c.Preview.Position=UDim2.fromOffset(8,8)
                    c.Preview.BackgroundColor3=theme.panel; c.Preview.BorderSizePixel=0; c.Preview.Ambient=Color3.fromRGB(210,219,226)
                    c.Preview.LightColor=Color3.fromRGB(255,232,202); c.Preview.Parent=row
                    c.Title.Position=UDim2.fromOffset(82,8); c.Title.Size=UDim2.new(1,-92,0,25)
                    c.Detail.Position=UDim2.fromOffset(82,34); c.Detail.Size=UDim2.new(1,-92,0,38)
                    c.Detail.TextWrapped=true; c.Detail.TextTruncate=Enum.TextTruncate.None
                    c.Income = label(row,"",UDim2.new(0.4,-10,0,44),UDim2.fromOffset(12,78),12,theme.mint)
                    c.Buy = button(row,"",UDim2.new(0.6,-16,0,44),UDim2.new(0.4,4,0,78),function()
                        action:FireServer(if state.Businesses[id] then "Upgrade" else "Buy",id)
                    end)
                end
                cards[id] = c
            end
        elseif tab=="Mercado" then
            for i,sector in ipairs(MarketConfig.SectorOrder) do
                local row = card(150,i); local c = details(row)
                local chart = frame(row,UDim2.new(1,-24,0,60),UDim2.fromOffset(12,57)); c.Bars = {}
                for j=1,MarketConfig.ChartPoints do
                    local bar = frame(chart,UDim2.new(),UDim2.new((j-1)/MarketConfig.ChartPoints,1,1,0),theme.mint)
                    bar.AnchorPoint = Vector2.new(0,1); c.Bars[j] = bar
                end
                c.Range = label(row,"",UDim2.new(1,-24,0,22),UDim2.fromOffset(12,123),10,theme.muted); cards[sector] = c
            end
        elseif tab=="Investir" then
            local controls = card(88,0)
            for i,amount in ipairs(MarketConfig.Lots) do
                lotButtons[amount] = button(controls,amount.." cota(s)",UDim2.new(1/3,-8,0,36),UDim2.new((i-1)/3,4,0,4),function() lot=amount; render() end)
            end
            button(controls,if history then "Voltar à carteira" else "Histórico de operações",UDim2.new(1,-8,0,36),UDim2.fromOffset(4,47),function() history=not history; signature=""; render() end,theme.gold)
            if history then
                for i=1,MarketConfig.HistoryLimit do cards[i] = details(card(65,i)) end
            else
                for i,sector in ipairs(MarketConfig.SectorOrder) do
                    local row = card(160,i); local c = details(row); c.Detail.Size = UDim2.new(1,-24,0,40)
                    c.Detail.TextWrapped = true; c.Detail.TextTruncate = Enum.TextTruncate.None
                    c.Pnl = label(row,"",UDim2.new(1,-24,0,24),UDim2.fromOffset(12,76),11)
                    local function trade(kind) confirmTrade(kind,sector) end
                    c.Buy = button(row,"",UDim2.new(0.5,-16,0,44),UDim2.fromOffset(12,108),function() trade("InvestBuy") end)
                    c.Sell = button(row,"",UDim2.new(0.5,-16,0,44),UDim2.new(0.5,4,0,108),function() trade("InvestSell") end)
                    cards[sector] = c
                end
            end
        elseif tab=="Ranking" then
            for i=1,10 do cards[i] = details(card(65,i)) end
        else
            local row = card(102,0); label(row,"Movimento reduzido",UDim2.new(1,-24,0,24),UDim2.fromOffset(12,8),15)
            cards.Motion = button(row,"",UDim2.new(1,-24,0,44),UDim2.fromOffset(12,46),function() action:FireServer("ReducedMotion",not state.Settings.ReducedMotion) end)
            cards.Guide=button(card(52,1),"",UDim2.new(1,-16,0,44),UDim2.fromOffset(8,4),function() guideHidden=not guideHidden; updateGuide(); render() end,theme.gold)
            local text = label(card(150,2),"Patrimônio = saldo + 70% do capital dos negócios + valor da carteira.\n\nCotações simuladas a cada 15s. Eventos duram 3 minutos.\n\nE: trabalhar • B: menu • F: terminal do terreno",UDim2.new(1,-24,1,-16),UDim2.fromOffset(12,8),12,theme.muted)
            text.TextWrapped = true; text.TextTruncate = Enum.TextTruncate.None
        end
    end
    if tab=="Negócios" or tab=="Coleção" then
        for _,id in ipairs(Config.BusinessOrder) do
            local c,row,owned = Config.Businesses[id],cards[id],state.Businesses[id]
            row.Row.Visible=tab~="Negócios" or UX.visibleBusiness(state,id,showAll)
            row.Row.LayoutOrder=if tab=="Negócios" and UX.nextBusiness(state)==id then 1 else (table.find(Config.BusinessOrder,id) or 0)+2
            local hidden = tab=="Coleção" and not state.Collection[id]
            row.Title.Text = if hidden then "? ? ? • Não descoberto" else c.Name
            row.Detail.Text = if hidden then "Continue expandindo para revelar." else c.Rarity.." • "..c.Category..(if owned then " • Nv. "..owned.Level.."/"..c.MaxLevel else "")
            if row.Buy then
                local cost = if owned then Economy.upgradeCost(id,owned) else c.Price
                local maxed = owned and owned.Level>=c.MaxLevel; local unlocked = Economy.unlocked(state,id)
                local income = if owned then Economy.incomeFor(id,owned,state.Market.Multipliers) else c.Income*state.Market.Multipliers[c.Category]
                row.Income.Text = "+"..Format.money(income).."/s"
                row.Buy.Text = if maxed then "NÍVEL MÁXIMO" elseif not unlocked then "BLOQUEADO" elseif state.Cash<cost then "Faltam "..Format.money(cost-state.Cash) else (if owned then "Melhorar " else "Inaugurar ")..Format.money(cost)
                enable(row.Buy,not maxed and unlocked and state.Cash>=cost)
            end
        end
    elseif tab=="Mercado" then
        for _,sector in ipairs(MarketConfig.SectorOrder) do
            local row,quote = cards[sector],state.Market
            row.Title.Text = MarketConfig.Sectors[sector].Name.." • "..Format.money(quote.Prices[sector])
            row.Detail.Text = "Renda dos negócios: x"..quote.Multipliers[sector]
            if row.Revision~=quote.Revision then
                row.Revision = quote.Revision; local low,high = math.huge,-math.huge
                for _,price in ipairs(quote.History[sector]) do low=math.min(low,price); high=math.max(high,price) end
                for i,price in ipairs(quote.History[sector]) do row.Bars[i].Size=UDim2.new(1/MarketConfig.ChartPoints,-2,0.1+0.9*(price-low)/math.max(0.01,high-low),0) end
                row.Range.Text = Format.money(low).." – "..Format.money(high).." • últimas 24 cotações"
            end
        end
    elseif tab=="Investir" then
        for amount,b in pairs(lotButtons) do b.BackgroundColor3=if amount==lot then theme.mint else theme.muted end
        if history then
            hint.Text = "Resultado realizado: "..Format.money(state.RealizedProfit)
            for i,row in ipairs(cards) do
                local trade = state.Trades[i]; row.Row.Visible=trade~=nil or i==1
                row.Title.Text = if trade then (if trade.Side=="Buy" then "Compra" else "Venda").." • "..trade.Sector.." • "..trade.Units.." cota(s)" else "Nenhuma operação ainda."
                row.Detail.Text = if trade then Format.money(trade.Total).." líquido • "..os.date("!%d/%m %H:%M UTC",trade.Time) else "Suas últimas 20 operações aparecem aqui."
            end
        else
            for _,sector in ipairs(MarketConfig.SectorOrder) do
                local row,holding,price = cards[sector],state.Investments[sector],state.Market.Prices[sector]
                local shares = if holding then holding.Shares else 0
                local pnl = shares*price-(if holding then holding.Cost else 0)
                row.Title.Text = MarketConfig.Sectors[sector].Name
                row.Detail.Text = shares.." cota(s) • valor "..Format.money(shares*price).."\nPreço: "..Format.preciseMoney(price).." por cota"
                row.Pnl.Text = "Resultado aberto: "..(if pnl>=0 then "+" else "")..Format.money(pnl).." (antes da taxa de venda)"
                row.Pnl.TextColor3 = if pnl>=0 then theme.mint else theme.error
                local cost = math.ceil(price*lot*(1+MarketConfig.Fee)*100)/100
                local proceeds = math.floor(price*lot*(1-MarketConfig.Fee)*100)/100
                row.Buy.Text = "Comprar "..Format.preciseMoney(cost); row.Sell.Text = "Vender "..Format.preciseMoney(proceeds)
                enable(row.Buy,state.Cash>=cost and shares+lot<=MarketConfig.MaxShares); enable(row.Sell,shares>=lot)
            end
        end
    elseif tab=="Ranking" then
        for i,row in ipairs(cards) do
            local entry = state.Ranking[i]; row.Row.Visible=entry~=nil
            if entry then row.Title.Text="#"..i.."  "..entry.Name; row.Detail.Text=Format.money(entry.NetWorth).." • "..entry.Businesses.." negócios" end
        end
    else
        cards.Motion.Text=if state.Settings.ReducedMotion then "ATIVADO" else "DESATIVADO"
        cards.Guide.Text=if guideHidden then "Mostrar guia inicial" else "Ocultar guia inicial"
    end
    task.defer(updatePreviews)
end
remotes:WaitForChild("EmpireState").OnClientEvent:Connect(function(data)
    data.Market = data.Market or (state and state.Market); state=data
    stats[1].Text=Format.money(data.Cash); stats[2].Text=Format.money(data.NetWorth); stats[3].Text="+"..Format.money(data.Income)
    if os.clock()>=messageUntil then save.Text=data.SaveStatus; save.TextColor3=if data.Temporary then theme.gold else theme.muted end
    if not data.Market then action:FireServer("Sync"); return end
    if pendingTrade and pendingTrade.Revision~=data.Market.Revision then
        enable(confirmButton,false); confirmText.Text="A cotação mudou. Cancele e selecione novamente para conferir o novo preço."
    end
    news.Text="MARKET NEWS • "..data.Market.Name.." • "..math.max(0,data.Market.EndsAt-data.ServerTime).."s"
    updateGuide()
    render()
end)
remotes:WaitForChild("EmpireFeedback").OnClientEvent:Connect(function(ok,message,kind)
    if kind=="OpenBusinesses" then openMenu(true,"Negócios"); return end
    if kind=="Work" and ok then
        workButton.Text="+$2 recebido"
        task.delay(Config.WorkCooldown,function() workButton.Text="+$2  Trabalhar" end)
    end
    messageUntil=os.clock()+3; local deadline=messageUntil
    feedback.Text=message; feedback.TextColor3=if ok then theme.mint else theme.error
    save.Text=message; save.TextColor3=feedback.TextColor3
    local folder=game:GetService("SoundService"):FindFirstChild("MoneyEmpireSounds")
    local sound=folder and folder:FindFirstChild(if not ok then "Error" elseif kind=="Buy" then "Purchase" elseif kind=="Upgrade" then "LevelUp" else "Cash")
    if sound and sound.SoundId~="" then sound:Play() end
    task.delay(3,function() if messageUntil==deadline then feedback.Text="" end end)
end)
Input.InputBegan:Connect(function(input,processed)
    if processed then return end
    if input.KeyCode==Enum.KeyCode.E then action:FireServer("Work") end
    if input.KeyCode==Enum.KeyCode.B then openMenu(not panel.Visible) end
end)
resize = function()
    if slide then slide:Cancel(); slide=nil end
    local d=UILayout.calculate(root.AbsoluteSize.X,root.AbsoluteSize.Y)
    header.Size=UDim2.fromOffset(d.HudWidth,d.HudHeight); dock.Size=UDim2.fromOffset(d.HudWidth,40)
    news.Size=UDim2.fromOffset(d.HudWidth,24); feedback.Size=UDim2.fromOffset(d.HudWidth,32)
    guide.Size=UDim2.fromOffset(d.HudWidth,66)
    panel.Position=UDim2.fromOffset(d.PanelX,d.PanelY); panel.Size=UDim2.fromOffset(d.PanelWidth,d.PanelHeight)
    confirmation.Position=UDim2.fromOffset(8,if d.PanelHeight<300 then 4 else 62)
    confirmation.Size=UDim2.new(1,-16,0,math.min(220,d.PanelHeight-8))
    local short=d.PanelHeight<340; local h=if short then 30 else 36
    tabs.Size=UDim2.new(1,-20,0,if short then 68 else 80)
    for i,name in ipairs(tabNames) do
        tabButtons[name].Size=UDim2.new(1/3,-4,0,h)
        tabButtons[name].Position=UDim2.new(((i-1)%3)/3,2,0,math.floor((i-1)/3)*(h+4)+2)
    end
    scroll.Position=UDim2.fromOffset(10,if short then 138 else 150)
    scroll.Size=UDim2.new(1,-20,0,math.max(0,d.PanelHeight-(if short then 176 else 188)))
    for _,l in ipairs(stats) do l.TextSize=d.StatTextSize end
    if updateGuide then updateGuide() end
    if updatePreviews then task.defer(updatePreviews) end
end
scroll:GetPropertyChangedSignal("CanvasPosition"):Connect(function() task.defer(updatePreviews) end)
root:GetPropertyChangedSignal("AbsoluteSize"):Connect(resize); resize()
action:FireServer("Sync")
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="25">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="Gravity">196.2</float>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">true</bool>
    </Properties>
  </Item>
</roblox>