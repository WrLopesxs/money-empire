      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">BusinessBlueprint</string>
          <string name="Source"><![CDATA[-- Original low-poly architecture. Pure data makes scale and part budgets testable.
local Config = require(if script then script.Parent.GameConfig else "./GameConfig")
local Blueprint = {}
function Blueprint.build(id, level)
    local c = Config.Businesses[id]
    assert(c, "Unknown business")
    level = math.clamp(math.floor(level), 1, c.MaxLevel)
    local parts = {}
    local dark, cream, glass = {31,45,58}, {231,225,203}, {132,201,218}
    local function add(name, size, position, color, material, shape)
        table.insert(parts, {Name=name, Size=size, Position=position, Color=color, Material=material or "SmoothPlastic", Shape=shape or "Block"})
    end
    add("Foundation", {21,0.6,22}, {0,0.3,0}, cream, "Concrete")
    local height
    if c.Model == "Stand" then
        height = 9
        add("Counter",{15,3,8},{0,2.1,1},c.Color)
        add("CounterTop",{16,0.5,9},{0,3.85,1},cream)
        for _,x in ipairs({-7,7}) do add("AwningPost",{0.5,5,0.5},{x,6,4},dark,"Wood") end
        for i=1,4 do add("StripedAwning",{4,0.6,11},{-10+i*4,8.7,0},if i%2==0 then cream else c.Color) end
        if id=="Water" then
            for i=1,3 do add("WaterBottle",{1,2,1},{-4+i*2,5,0},glass,"Glass") end
            add("IceBox",{3,2,3},{5,4.8,1},cream)
        elseif id=="FoodCart" then
            add("Grill",{6,0.6,4},{0,4.4,1},dark,"Metal")
            for _,x in ipairs({-6,6}) do add("CartWheel",{2,2,2},{x,1.7,-3.5},dark,"SmoothPlastic","Ball") end
            add("FoodTray",{3,0.6,2},{5,4.4,0},{235,168,76})
        else
            add("Pitcher",{2,3,2},{0,5.6,1},{245,215,87},"Glass")
            for i=1,3 do add("Lemon",{1,1,1},{-6+i*1.5,4.6,-1},{245,220,81},nil,"Ball") end
        end
    elseif c.Model == "Shop" then
        height = 14 + math.floor((level-1)/3)*2
        add("ShopBody",{18,height,17},{0,height/2+0.6,1},cream,"Concrete")
        add("Storefront",{15,7,0.2},{0,4.4,-7.6},glass,"Glass")
        add("Door",{3,7,0.3},{0,4.2,-7.8},dark,"Glass")
        for _,x in ipairs({-7.5,-2,2,7.5}) do add("Frame",{0.3,7.3,0.3},{x,4.4,-7.9},dark,"Metal") end
        add("BrandBand",{19,2.5,1},{0,9.5,-8},c.Color)
        add("Canopy",{20,0.7,5},{0,8,-7.5},c.Color)
        add("Roof",{20,0.8,20},{0,height+1,1},dark)
        if id=="Coffee" then
            add("CupIcon",{2.5,3,2.5},{0,height+3,1},cream)
            add("CupHandle",{1.5,1.5,1},{1.7,height+3,1},cream)
        elseif id=="Restaurant" then
            for _,x in ipairs({-5,5}) do add("TerracePlanter",{3,1.5,2},{x,1.3,-9.5},c.Color); add("Greenery",{2.5,1.4,1.6},{x,2.6,-9.5},{95,149,107}) end
        else
            add("RoofSign",{12,3,1},{0,height+2.6,-5},c.Color)
            add("StockCrate",{3,2,3},{7,1.6,-9},dark,"Wood")
        end
    elseif id=="Factory" then
        height = 22
        add("Warehouse",{19,12,18},{0,6.6,0},c.Color,"Concrete")
        add("Roof",{21,1,20},{0,13,0},dark,"Metal")
        add("LoadingDoor",{9,8,0.3},{-3,4.6,-9.2},dark,"Metal")
        add("OfficeWindow",{5,3,0.3},{6,7,-9.2},glass,"Glass")
        for _,x in ipairs({-6,6}) do add("Chimney",{2,8,2},{x,17,5},cream,"Metal"); add("ChimneyCap",{3,1,3},{x,21.5,5},dark) end
    else
        local index = table.find(Config.BusinessOrder,id)
        height = 22 + index*2 + math.floor((level-1)/3)*4
        add("Podium",{20,5,20},{0,3.1,0},cream,"Concrete")
        add("Tower",{16,height-5,16},{0,5.6+(height-5)/2,1},dark,"Concrete")
        local floors=math.min(6,math.floor(height/6))
        for floor=1,floors do
            local y = 7 + (floor-1)*(height-8)/floors
            add("FrontGlass",{14,3.5,0.2},{0,y,-7.1},glass,"Glass")
            add("SideGlass",{0.2,3.5,14},{8.1,y,1},glass,"Glass")
        end
        for _,x in ipairs({-7.5,7.5}) do add("FacadeFin",{0.5,height-2,0.5},{x,height/2+1,-7.4},c.Color,"Metal") end
        add("Crown",{18,1,18},{0,height+1.2,1},c.Color,"Metal")
        add("Lobby",{7,4,0.3},{0,2.6,-10.1},glass,"Glass")
        if id=="Space" then
            add("Observatory",{7,7,7},{0,height+5,1},c.Color,"Neon","Ball")
            add("Antenna",{0.6,5,0.6},{0,height+10,1},cream,"Metal")
        elseif id=="Bank" then
            for _,x in ipairs({-8,8}) do add("Column",{1.5,5,1.5},{x,3.1,-9},cream) end
        else
            add("RoofGarden",{10,0.8,8},{0,height+2,1},{80,138,112},"Grass")
            add("RoofCore",{5,3,5},{3,height+3,3},c.Color)
        end
    end
    add("LevelAccent",{level*1.5,0.3,0.3},{0,1,-10.8},c.Color,"Neon")
    return { Parts=parts, Height=height+14, Level=level, Name=c.Name }
end
return Blueprint
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">BusinessVisual</string>
          <string name="Source"><![CDATA[local Blueprint = require(script.Parent.BusinessBlueprint)
local Visual = {}
function Visual.build(parent,id,level)
    local plan = Blueprint.build(id,level)
    local model = Instance.new("Model"); model.Name=id
    for _,item in ipairs(plan.Parts) do
        local p=Instance.new("Part"); p.Name=item.Name
        p.Size=Vector3.new(unpack(item.Size)); p.CFrame=CFrame.new(unpack(item.Position))
        p.Color=Color3.fromRGB(unpack(item.Color)); p.Material=Enum.Material[item.Material]; p.Shape=Enum.PartType[item.Shape]
        p.Anchored=true; p.CanTouch=false; p.TopSurface=Enum.SurfaceType.Smooth; p.BottomSurface=Enum.SurfaceType.Smooth
        p.Parent=model
    end
    -- Explicit origin: PivotTo must not use the bounding-box center of a tall tower.
    model.WorldPivot=CFrame.new(); model.Parent=parent
    return model,plan.Height
end
return Visual
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Economy</string>
          <string name="Source"><![CDATA[-- Pure Luau domain logic: the same implementation runs in Roblox and in CLI tests.
local Config = require(if script then script.Parent.GameConfig else "./GameConfig")
local Investments = require(if script then script.Parent.InvestmentModel else "./InvestmentModel")
local Economy = {}
local function finite(n, minimum, maximum)
    return type(n) == "number" and n == n and n >= minimum and n <= maximum
end
function Economy.newProfile()
    return { Version = 1, Cash = Config.StartingCash, Businesses = {}, Collection = {}, LifetimeEarned = 0, WorkCount = 0, Settings = { ReducedMotion = false }, Revision = 0, Investments = {}, Trades = {}, RealizedProfit = 0 }
end
function Economy.validate(p)
    if type(p) ~= "table" or p.Version ~= 1 then return false end
    if not finite(p.Cash, 0, Config.MaxCash) or not finite(p.LifetimeEarned, 0, Config.MaxCash) then return false end
    if not finite(p.WorkCount, 0, 1e12) or p.WorkCount % 1 ~= 0 then return false end
    if not finite(p.Revision, 0, 1e15) or p.Revision % 1 ~= 0 then return false end
    if type(p.Businesses) ~= "table" or type(p.Collection) ~= "table" or type(p.Settings) ~= "table" then return false end
    if type(p.Settings.ReducedMotion) ~= "boolean" then return false end
    for id, owned in pairs(p.Businesses) do
        local c = Config.Businesses[id]
        if not c or type(owned) ~= "table" then return false end
        if not finite(owned.Level, 1, c.MaxLevel) or owned.Level % 1 ~= 0 then return false end
        if not Config.Variants[owned.Variant] or not finite(owned.Invested, c.Price, Config.MaxCash) then return false end
    end
    for id, discovered in pairs(p.Collection) do
        if not Config.Businesses[id] or discovered ~= true then return false end
    end
    return Investments.validate(p)
end
function Economy.incomeFor(id, owned, multipliers)
    local category = Config.Businesses[id].Category
    local marketBoost = if multipliers then multipliers[category] or 1 else 1
    return Config.Businesses[id].Income * Config.UpgradeIncomeGrowth ^ (owned.Level - 1) * Config.Variants[owned.Variant] * marketBoost
end
function Economy.income(p, multipliers)
    local total = 0
    for id, owned in pairs(p.Businesses) do total += Economy.incomeFor(id, owned, multipliers) end
    return total
end
function Economy.netWorth(p, prices)
    local total = p.Cash + Investments.value(p, prices)
    for _, owned in pairs(p.Businesses) do total += math.floor(owned.Invested * Config.ResaleRatio) end
    return total
end
function Economy.title(p, prices)
    local result, worth = Config.Titles[1].Name, Economy.netWorth(p, prices)
    for _, entry in ipairs(Config.Titles) do if worth >= entry.Value then result = entry.Name end end
    return result
end
function Economy.unlocked(p, id)
    for i, entry in ipairs(Config.BusinessOrder) do
        if entry == id then return i == 1 or p.Collection[Config.BusinessOrder[i - 1]] == true end
    end
    return false
end
function Economy.upgradeCost(id, owned)
    return math.floor(Config.Businesses[id].Price * 0.65 * Config.UpgradeCostGrowth ^ (owned.Level - 1))
end
function Economy.credit(p, amount)
    if not finite(amount, 0, Config.MaxCash) then return false end
    p.Cash = math.min(Config.MaxCash, p.Cash + amount)
    p.LifetimeEarned = math.min(Config.MaxCash, p.LifetimeEarned + amount)
    return true
end
function Economy.work(p)
    Economy.credit(p, Config.WorkReward)
    p.WorkCount += 1
    return true, "+$" .. Config.WorkReward
end
function Economy.buy(p, id)
    local c = Config.Businesses[id]
    if not c or not Economy.unlocked(p, id) then return false, "Compre o negócio anterior para desbloquear." end
    if p.Businesses[id] then return false, "Você já tem este negócio." end
    if p.Cash < c.Price then return false, "Dinheiro insuficiente." end
    p.Cash -= c.Price
    p.Businesses[id] = { Level = 1, Variant = "Normal", Invested = c.Price }
    p.Collection[id] = true
    return true, c.Name .. " inaugurado!"
end
function Economy.upgrade(p, id)
    local owned, c = p.Businesses[id], Config.Businesses[id]
    if not owned or not c then return false, "Negócio não encontrado." end
    if owned.Level >= c.MaxLevel then return false, "Nível máximo atingido." end
    local cost = Economy.upgradeCost(id, owned)
    if p.Cash < cost then return false, "Dinheiro insuficiente." end
    p.Cash -= cost
    owned.Invested += cost
    owned.Level += 1
    return true, "Upgrade concluído!"
end
function Economy.tick(p, elapsed, multipliers)
    if not finite(elapsed, 0, 10) then return false end
    return Economy.credit(p, Economy.income(p, multipliers) * elapsed)
end
function Economy.count(p)
    local n = 0
    for _ in pairs(p.Businesses) do n += 1 end
    return n
end
return Economy
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">GameConfig</string>
          <string name="Source"><![CDATA[-- All economy tuning lives here. No paid purchases in the MVP.
local Config = {
    StartingCash = 1,
    WorkReward = 2,
    WorkCooldown = 0.65,
    TickSeconds = 1,
    SnapshotSeconds = 1,
    AutosaveSeconds = 60,
    SessionLeaseSeconds = 180,
    SaveRetries = 3,
    MaxCash = 1e33,
    ResaleRatio = 0.7,
    UpgradeCostGrowth = 1.65,
    UpgradeIncomeGrowth = 1.4,
    RemoteBurst = 12,
    RemotePerSecond = 6,
    PlotCount = 8,
    PlotSpacing = 150,
    -- Local Studio play is deliberately ephemeral. Set false only in a published TEST place.
    StudioTemporaryData = true,
    StoreName = "MoneyEmpire_v1",
    StudioStoreName = "MoneyEmpire_TEST_v1",
    Rarities = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic", "Secret" },
    Variants = { Normal = 1, Golden = 2, Diamond = 3, Rainbow = 5, Viral = 7, Overclocked = 10, Cosmic = 25 },
    BusinessOrder = { "Water", "FoodCart", "Lemonade", "Coffee", "Market", "Restaurant", "Factory", "Tech", "Bank", "Luxury", "Tower", "Conglomerate", "PrivateCity", "Global", "Space" },
    Businesses = {
        Water = { Name = "Água gelada", Price = 10, Income = 1, Rarity = "Common", Category = "Food", MaxLevel = 10, Color = {70, 198, 232}, Model = "Stand" },
        FoodCart = { Name = "Carrinho de comida", Price = 80, Income = 5, Rarity = "Common", Category = "Food", MaxLevel = 10, Color = {248, 162, 67}, Model = "Stand" },
        Lemonade = { Name = "Estação limonada", Price = 450, Income = 22, Rarity = "Uncommon", Category = "Food", MaxLevel = 10, Color = {202, 226, 86}, Model = "Stand" },
        Coffee = { Name = "Café Aurora", Price = 2500, Income = 95, Rarity = "Uncommon", Category = "Food", MaxLevel = 10, Color = {216, 155, 113}, Model = "Shop" },
        Market = { Name = "Mercado Central", Price = 12000, Income = 380, Rarity = "Rare", Category = "Food", MaxLevel = 10, Color = {76, 209, 162}, Model = "Shop" },
        Restaurant = { Name = "Restaurante Âmbar", Price = 65000, Income = 1700, Rarity = "Rare", Category = "Food", MaxLevel = 10, Color = {244, 115, 93}, Model = "Shop" },
        Factory = { Name = "Fábrica Horizonte", Price = 350000, Income = 7200, Rarity = "Epic", Category = "Energy", MaxLevel = 10, Color = {128, 144, 189}, Model = "Tower" },
        Tech = { Name = "Nexo Tecnologia", Price = 2000000, Income = 33000, Rarity = "Epic", Category = "Tech", MaxLevel = 10, Color = {81, 158, 255}, Model = "Tower" },
        Bank = { Name = "Banco Meridian", Price = 12000000, Income = 155000, Rarity = "Legendary", Category = "Finance", MaxLevel = 10, Color = {248, 201, 89}, Model = "Tower" },
        Luxury = { Name = "Maison Celeste", Price = 70000000, Income = 700000, Rarity = "Legendary", Category = "Luxury", MaxLevel = 10, Color = {218, 151, 223}, Model = "Tower" },
        Tower = { Name = "Torre Infinita", Price = 400000000, Income = 3200000, Rarity = "Legendary", Category = "Real Estate", MaxLevel = 10, Color = {113, 204, 221}, Model = "Tower" },
        Conglomerate = { Name = "Grupo Atlas", Price = 2500000000, Income = 15000000, Rarity = "Mythic", Category = "Finance", MaxLevel = 10, Color = {248, 114, 171}, Model = "Tower" },
        PrivateCity = { Name = "Cidade Elysium", Price = 15000000000, Income = 70000000, Rarity = "Mythic", Category = "Real Estate", MaxLevel = 10, Color = {147, 125, 239}, Model = "Tower" },
        Global = { Name = "Império Global", Price = 100000000000, Income = 340000000, Rarity = "Mythic", Category = "Transport", MaxLevel = 10, Color = {71, 227, 203}, Model = "Tower" },
        Space = { Name = "Órbita Espacial", Price = 1000000000000, Income = 1800000000, Rarity = "Secret", Category = "Tech", MaxLevel = 10, Color = {192, 171, 255}, Model = "Tower" },
    },
    Titles = {
        { Value = 0, Name = "Primeiro passo" }, { Value = 1000, Name = "Empreendedor" },
        { Value = 1000000, Name = "Millionaire" }, { Value = 10000000, Name = "Multi-Millionaire" },
        { Value = 1000000000, Name = "Billionaire" }, { Value = 100000000000, Name = "Empire Owner" },
        { Value = 1000000000000, Name = "World Elite" },
    },
}
return Config
]]></string>
